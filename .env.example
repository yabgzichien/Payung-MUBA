# Copy to .env and fill in. .env is gitignored — keep it that way.

# BURNER WALLET ONLY. Fund it with ~$20 USDC on Base and nothing else.
# This repo becomes public at submission. Never put your main wallet key here.
PRIVATE_KEY=0x

# Base mainnet RPC. The public one works; get an Alchemy/QuickNode key if you hit rate limits.
BASE_RPC_URL=https://mainnet.base.org

# Groq — fast inference. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
