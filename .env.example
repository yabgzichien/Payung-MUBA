# Copy to .env and fill in. .env is gitignored — keep it that way.

# BURNER WALLET ONLY. Fund it with ~$20 USDC on Base and nothing else.
# This repo becomes public at submission. Never put your main wallet key here.
PRIVATE_KEY=0x

# Base mainnet RPC. The public one works; get an Alchemy/QuickNode key if you hit rate limits.
BASE_RPC_URL=https://mainnet.base.org

# Groq — fast inference. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# Precise Protection (automated roll module). OPTIONAL.
#
# Leave every variable below blank and the feature degrades cleanly: the setup
# screen says it is unavailable on this deployment and refuses to start, so
# nothing is deployed and no USDC is moved. Filling them in turns it on.
#
# Both addresses must be the SAME deployed PayungRollModule. The server uses
# the first to encode open()/cancel() and to read commitments(); the browser
# uses the second to build the Safe's enableModule() call. If only one is set,
# setup fails its preflight and stops before spending anything.
# ---------------------------------------------------------------------------
PAYUNG_ROLL_MODULE_ADDRESS=
NEXT_PUBLIC_PAYUNG_ROLL_MODULE_ADDRESS=

# Chainlink price feeds on Base, used to key a commitment to its underlying.
# Required only when the roll module above is configured.
# ETH/USD  0x71041dddad3595F9CEd3DcCFBe3D1F4b0a16Bb70
# BTC/USD  0xCCADC697c55bbB68dc5bCdf8d3CBe83CdD4E071E
CHAINLINK_FEED_ETH=
CHAINLINK_FEED_BTC=
